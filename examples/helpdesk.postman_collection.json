{
  "info": {
    "name": "Helpdesk API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order. Uses only demo records created by this collection. Set base_url and api_key."
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "ticket_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo user\",\n  \"email\": \"demo-{{$guid}}@example.test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"user_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo {{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"category_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Printer broken\",\n  \"description\": \"No paper feed\",\n  \"author_id\": {{user_id}},\n  \"category_id\": {{category_id}},\n  \"priority\": \"high\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"ticket_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Filter tickets",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tickets?status=new&priority=high&page=1&per_page=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Reject invalid transition",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"closed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Start work",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Add comment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Replacing paper tray\",\n  \"author_id\": {{user_id}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 List comments",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Close ticket",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"closed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Delete ticket",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Delete demo user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/users/{{user_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Delete demo category",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/categories/{{category_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}